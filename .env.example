# ---------------------------------------------------------------------------
# SelfMastery — environment variables
# Copy to .env and fill in. Never commit .env.
# See DEPLOY.md for hosting this free on Vercel + Neon.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the app at runtime.
# On a hosted provider this is the POOLED connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/selfmastery?schema=public"

# Direct (unpooled) connection, used only for migrations. A connection pooler
# cannot run schema changes inside a transaction, so `prisma migrate deploy`
# needs to bypass it. Locally this can be left unset.
# DIRECT_URL="postgresql://USER:PASSWORD@direct-host:5432/selfmastery?sslmode=require"

# Optional. Separate database Prisma uses to diff migrations during development.
# Not needed in production.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/selfmastery_shadow?schema=public"

# Secret used by Auth.js to sign session cookies and JWTs.
# Generate with: openssl rand -base64 32
# Required in production — the app refuses to start without it.
AUTH_SECRET=""

# Canonical public URL. Used for link previews, sitemap and canonical URLs.
# On Vercel this falls back to the deployment URL automatically.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Rate limiting for sign-up and sign-in, via Upstash Redis (free, no card).
# Leave unset locally — the limiter degrades to "allow". Set both in production
# or anonymous sign-up is unthrottled; the app logs a warning if they're missing.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Transactional email. Password reset returns 503 rather than silently
# dropping the message when none of this is set. Two ways to configure it —
# MAIL_FROM is required either way. See DEPLOY.md section 6.
MAIL_FROM="SelfMastery <you@gmail.com>"

# (a) SMTP — needs no domain. In practice Gmail with an App Password: the mail
# goes out through Google from your own @gmail.com address, so SPF and DKIM
# align. Requires 2-Step Verification on the account. Roughly 500/day.
# SMTP_PASSWORD is an App Password, never your Google account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD=""

# (b) Resend — once you own a domain. Takes precedence over SMTP when set, and
# MAIL_FROM must then be an address at the domain verified in Resend.
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Optional / future
# ---------------------------------------------------------------------------

# Google OAuth. Leave blank to keep the provider disabled.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Plan generator implementation. "rule-based" (default, no API key required)
# is the only implementation shipped today. An AI-backed generator can be
# selected here later without changing application code.
PLAN_GENERATOR="rule-based"

# Guard rail: the seed deletes and rebuilds the demo account, so it refuses to
# run against NODE_ENV=production unless this is explicitly set.
# ALLOW_SEED="false"
